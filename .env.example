# Discord webhook URL to post notifications to.
# Create one in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Mention to lead each notification with, e.g. @everyone or <@your-user-id>. Discord holds
# back a plain message's mobile push while you look active on another client, and drops it
# for a muted channel -- a mention gets through both. Leave empty for no mention.
DISCORD_MENTION=@everyone

# Webhook for operational reports -- what the app did and, above all, what it declined to
# do: auto-booking that couldn't run, a check that crashed, a whole cycle that failed.
# Leave empty to send them to DISCORD_WEBHOOK_URL instead; set it to a separate webhook to
# keep the ops noise out of the channel you watch for free seats. Reports never mention
# anyone -- they are not what you asked to be woken for.
DISCORD_LOG_WEBHOOK_URL=

# --- Discord bot, for approving a booking --------------------------------------------
# Created at discord.com/developers/applications. The bot needs only "Send Messages" and
# no privileged intents -- approval happens through buttons, not message content.
# The token is a password: never share it, never commit it.
DISCORD_BOT_TOKEN=

# Channel the bot posts booking requests in (right-click the channel -> Copy Channel ID).
DISCORD_CHANNEL_ID=

# Channel the bot posts operational reports in, addressed the same way. Set this and the
# ops noise goes to its own channel without a webhook having to exist for it -- which is
# the difference from DISCORD_LOG_WEBHOOK_URL above, not a second way to say the same
# thing. When both are set this one wins, and the webhook stays the fallback for the
# reports the bot cannot deliver: its own token missing, its login refused, its gateway
# dropped. Leave empty to use the webhook for everything.
DISCORD_LOG_CHANNEL_ID=

# Discord user ids allowed to approve a purchase, comma separated. Every other click is
# refused -- without this, anyone in the server could spend the travel credit.
DISCORD_APPROVERS=

# --- Destination Gotland account, for auto-booking -----------------------------------
# The account a booking is made on. Travel credit (reskassa) belongs to an account and
# only shows up as a payment method on that account, so this must be the one holding it.
DG_USERNAME=
DG_PASSWORD=

# Travellers to pick from "Mina sparade resenärer" on the passenger step, comma separated,
# in the order they should fill the passenger slots. Each name must match the site exactly.
DG_PASSENGERS=

# --- Auto-booking --------------------------------------------------------------------
# Master switch. Off means the scheduler never even prepares a checkout, whatever an
# individual watch's Auto switch says. The per-watch switch can only ever narrow this,
# never widen it -- both have to be on.
AUTO_BOOKING_ENABLED=0

# THE ONE SETTING THAT SPENDS MONEY WITHOUT ASKING.
# Off (0, and anything that is not exactly "1") the flow stops at the checkout and asks in
# Discord: somebody in DISCORD_APPROVERS presses "Godkänn köp" and only then is Betala
# clicked. On (1) a prepared checkout is PAID immediately and Discord is told afterwards,
# with the screenshot.
#
# What still stands between a check and a purchase with this on: AUTO_BOOKING_ENABLED must
# also be 1, the watch's own Auto switch must be on, the fare class and lounge must be ones
# that watch asked for, and the price cap refuses a checkout that came out too expensive.
# The cap is the last line and the only one that holds when everything else misreads -- set
# it to what you are genuinely willing to wake up to having paid.
#
# This is also what lets a watch run outside the daily check window: a watch that needs a
# human at 04:00 is exactly what the window exists to prevent, so the exemption follows
# this switch and not the Auto switch.
AUTO_BOOKING_UNATTENDED=0

# Set to 1 to run npm run book headless. Leave at 0 (a visible browser) while you're still
# watching it work. The live scheduler/bot flow always runs headless-by-default the same
# way -- this only affects the manual `npm run book -- <watchId>` dry run.
BOOKING_HEADLESS=0

# How long an approval button in Discord stays live. Ignored when AUTO_BOOKING_UNATTENDED
# is on -- there is no button then. A held seat does not last forever,
# and approving a stale offer must not book on old information. When it expires, the
# parked browser session is closed unpressed and the watch keeps running.
BOOKING_APPROVAL_MINUTES=10

# Base interval (in minutes) between check cycles. Only used until you save the interval
# in the web UI -- after that the stored value wins and these two are ignored.
CHECK_INTERVAL_MINUTES=5

# Random jitter (in minutes) added on top of the base interval, so checks don't land on
# the same clock tick every hour. 10 + 0-5 means an actual interval of 10-15 minutes.
CHECK_JITTER_MINUTES=5

# Daily window the checks run in, HH:MM in Swedish time. End before start means a window
# across midnight; identical values mean no window, i.e. checks around the clock.
# Same rule as above: only used until you save the window in the web UI.
CHECK_WINDOW_FROM=06:00
CHECK_WINDOW_TO=00:00

# Port for the local web UI.
PORT=4000

# Set to 1 to save a screenshot + text dump to debug/ on every check (not just on "unknown" results).
DEBUG_SCRAPER=0
